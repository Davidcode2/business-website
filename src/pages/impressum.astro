---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { Icon } from 'astro-icon/components';
import { getTranslations } from '../i18n/translations';

const locale = 'de';
const t = getTranslations(locale);
---

<Layout title="Impressum - Jakob Lingel" description="Legal notice and contact information for Jakob Lingel." lang={locale}>
  <Navigation currentLocale={locale} currentPath="/impressum" isServicePage={true} />
  
  <main class="pt-24 pb-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-(--color-text-primary) mb-8">Impressum</h1>
      
      <div class="space-y-8 text-(--color-text-secondary)">
         <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">Angaben gemäß § 5 DDG</h2>
          <p class="leading-relaxed">
            Jakob Lingel<br />
            Räterweg 9<br />
            73560 Böbingen an der Rems
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">Kontakt</h2>
          <p class="leading-relaxed">
            E-Mail: <a href="mailto:jakob.lingel@hotmail.de" class="text-(--color-accent) hover:text-(--color-accent-weak) transition-colors">jakob.lingel@hotmail.de</a><br />
            <a
              href="https://de.linkedin.com/in/jakob-lingel-613976253"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-(--color-accent) hover:text-(--color-accent-weak) transition-colors mt-2"
            >
              <Icon name="simple-icons:linkedin" class="w-5 h-5" />
              LinkedIn
            </a>
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">Wirtschafts-Identifikationsnummer</h2>
          <p class="leading-relaxed">
            gemäß § 139c Abgabenordnung:<br />
            DE457840760-00001
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
          <p class="leading-relaxed">
            Jakob Lingel<br />
            Räterweg 9<br />
            73560 Böbingen an der Rems
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">EU-Streitbeilegung</h2>
          <p class="leading-relaxed">
            Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit: <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener noreferrer" class="text-(--color-accent) hover:text-(--color-accent-weak) transition-colors">https://ec.europa.eu/consumers/odr/</a>. Unsere E-Mail-Adresse finden Sie oben im Impressum.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4" style="overflow-wrap: break-word;">Verbraucher&shy;streitbeilegung/Universalschlichtungsstelle</h2>
          <p class="leading-relaxed">
            Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
          </p>
        </section>
      </div>
      
      <div class="mt-12 pt-8 border-t border-(--color-border)">
        <a href="/" class="text-(--color-accent) hover:text-(--color-accent-weak) transition-colors">
          ← Back to homepage
        </a>
      </div>
    </div>
  </main>
  
  <Footer locale={locale} isServicePage={true} />
</Layout>
