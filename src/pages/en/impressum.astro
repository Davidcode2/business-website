---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { Icon } from 'astro-icon/components';
import { getTranslations } from '../../i18n/translations';

const locale = 'en';
const t = getTranslations(locale);
---

<Layout title="Legal Notice - Jakob Lingel" description="Legal notice and contact information for Jakob Lingel." lang={locale}>
  <Navigation currentLocale={locale} currentPath="/en/impressum" isServicePage={true} />
  
  <main class="pt-24 pb-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-(--color-text-primary) mb-8">{t.impressum.title}</h1>
      
      <div class="space-y-8 text-(--color-text-secondary)">
        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">Information according to § 5 DDG</h2>
          <p class="leading-relaxed">
            Jakob Lingel<br />
            Räterweg 9<br />
            73560 Böbingen an der Rems<br />
            Germany
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">Contact</h2>
          <p class="leading-relaxed">
            Email: <a href="mailto:jakob.lingel@hotmail.de" class="text-(--color-accent) hover:text-(--color-accent-weak) transition-colors">jakob.lingel@hotmail.de</a><br />
            <a
              href="https://de.linkedin.com/in/jakob-lingel-613976253"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-(--color-accent) hover:text-(--color-accent-weak) transition-colors mt-2"
            >
              <Icon name="simple-icons:linkedin" class="w-5 h-5" />
              LinkedIn
            </a>
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">Tax Identification Number</h2>
          <p class="leading-relaxed">
            according to § 139c German Fiscal Code:<br />
            DE457840760-00001
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">Responsible for Content according to § 18 Abs. 2 MStV</h2>
          <p class="leading-relaxed">
            Jakob Lingel<br />
            Räterweg 9<br />
            73560 Böbingen an der Rems
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">EU Dispute Resolution</h2>
          <p class="leading-relaxed">
            The European Commission provides a platform for online dispute resolution (ODR): <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener noreferrer" class="text-(--color-accent) hover:text-(--color-accent-weak) transition-colors">https://ec.europa.eu/consumers/odr/</a>. Our email address can be found above in the legal notice.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-(--color-text-primary) mb-4">Consumer Dispute Resolution</h2>
          <p class="leading-relaxed">
            We are not willing or obligated to participate in dispute resolution proceedings before a consumer arbitration board.
          </p>
        </section>
      </div>
      
      <div class="mt-12 pt-8 border-t border-(--color-border)">
        <a href="/en/" class="text-(--color-accent) hover:text-(--color-accent-weak) transition-colors">
          ← Back to homepage
        </a>
      </div>
    </div>
  </main>
  
  <Footer locale={locale} isServicePage={true} />
</Layout>
