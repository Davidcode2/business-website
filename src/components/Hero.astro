---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = getTranslations(locale);
---

<section class="relative min-h-screen flex items-center overflow-hidden pt-20 blueprint-grid">
  <!-- Decorative Elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- Large background number -->
    <div class="absolute -right-20 top-1/3 text-[30rem] font-display font-bold text-[var(--color-text-primary)] opacity-[0.02] leading-none select-none">
      01
    </div>

    <!-- Vertical lines -->
    <div class="absolute left-[10%] top-0 bottom-0 w-[1px] bg-[var(--color-border)]"></div>
    <div class="absolute right-[25%] top-0 bottom-0 w-[1px] bg-[var(--color-border)]"></div>

    <!-- Scrolling tech indicators -->
    <div class="absolute left-8 bottom-1/3 flex flex-col gap-2 text-[var(--color-text-muted)] font-display text-xs tracking-wider">
      <span>AWS</span>
      <span>K8s</span>
      <span>TS</span>
      <span>React</span>
    </div>
  </div>

  <!-- Main Content -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-8 py-20">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Text Content -->
      <div class="space-y-8">
        <!-- Section Marker -->
        <div class="flex items-center gap-4 animate-slide-up stagger-1">
          <div class="w-12 h-[1px] bg-[var(--color-accent-primary)]"></div>
          <span class="font-display text-xs tracking-[0.3em] text-[var(--color-accent-primary)] uppercase">
            {t.hero.tagline}
          </span>
        </div>

        <!-- Headline -->
        <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-[var(--color-text-primary)] leading-[0.95] tracking-tight animate-slide-up stagger-2">
          <span class="block">{t.hero.headline1}</span>
          <span class="block gradient-text">{t.hero.headline2}</span>
          <span class="block">{t.hero.headline3}</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] max-w-lg leading-relaxed font-body animate-slide-up stagger-3">
          {t.hero.subheadline}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 pt-4 animate-slide-up stagger-4">
          <a href="#contact" class="btn-primary group">
            <span>{t.hero.ctaPrimary}</span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="#services" class="btn-secondary">
            <span>{t.hero.ctaSecondary}</span>
          </a>
        </div>

        <!-- Stats Row -->
        <div class="flex gap-12 pt-8 animate-slide-up stagger-5">
          <div>
            <div class="font-display text-3xl font-bold text-[var(--color-text-primary)]">5+</div>
            <div class="text-sm text-[var(--color-text-muted)] font-display uppercase tracking-wider">{locale === 'de' ? 'Jahre' : 'Years'}</div>
          </div>
          <div>
            <div class="font-display text-3xl font-bold text-[var(--color-text-primary)]">20+</div>
            <div class="text-sm text-[var(--color-text-muted)] font-display uppercase tracking-wider">{locale === 'de' ? 'Projekte' : 'Projects'}</div>
          </div>
          <div>
            <div class="font-display text-3xl font-bold text-[var(--color-accent-primary)]">99%</div>
            <div class="text-sm text-[var(--color-text-muted)] font-display uppercase tracking-wider">{locale === 'de' ? 'Uptime' : 'Uptime'}</div>
          </div>
        </div>
      </div>

      <!-- Right: Visual Element -->
      <div class="relative hidden lg:block animate-slide-up stagger-3">
        <!-- Blueprint-style illustration container -->
        <div class="relative aspect-square max-w-lg mx-auto">
          <!-- Background grid -->
          <div class="absolute inset-0 border border-[var(--color-border)]">
            <div class="absolute inset-0" style="background-image: linear-gradient(var(--color-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-border) 1px, transparent 1px); background-size: 40px 40px; opacity: 0.3;"></div>
          </div>

          <!-- Central element with 3D rotation animation -->
          <div class="absolute inset-8 border border-[var(--color-accent-primary)]/30 flex items-center justify-center perspective-container">
            <div class="rotate-3d-box">
              <!-- Geometric shapes with slow rotation -->
              <div class="inner-box w-48 h-48 border-2 border-[var(--color-accent-primary)] rotate-45 flex items-center justify-center">
                <div class="w-32 h-32 bg-[var(--color-accent-muted)]"></div>
              </div>

              <!-- Fixed kube icon in center -->
              <div class="kube-icon-fixed">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-accent-primary)]"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
              </div>

              <!-- Orbiting 3D cubes wrapper -->
              <div class="orbit-dots-container">
                <!-- Cube 1 - orbits clockwise -->
                <div class="orbit-cube-wrapper orbit-cube-1">
                  <div class="cube cube-secondary">
                    <div class="cube-face cube-face-front"></div>
                    <div class="cube-face cube-face-back"></div>
                    <div class="cube-face cube-face-left"></div>
                    <div class="cube-face cube-face-right"></div>
                    <div class="cube-face cube-face-top"></div>
                    <div class="cube-face cube-face-bottom"></div>
                  </div>
                </div>
                <!-- Cube 2 - orbits counter-clockwise -->
                <div class="orbit-cube-wrapper orbit-cube-2">
                  <div class="cube cube-primary">
                    <div class="cube-face cube-face-front"></div>
                    <div class="cube-face cube-face-back"></div>
                    <div class="cube-face cube-face-left"></div>
                    <div class="cube-face cube-face-right"></div>
                    <div class="cube-face cube-face-top"></div>
                    <div class="cube-face cube-face-bottom"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Measurement markers -->
          <div class="absolute top-4 left-4 font-display text-xs text-[var(--color-text-muted)] tracking-wider">01-A</div>
          <div class="absolute bottom-4 right-4 font-display text-xs text-[var(--color-text-muted)] tracking-wider">REV.2024</div>

          <!-- Tech stack indicators around the visual -->
          <div class="absolute -left-4 top-1/4 flex items-center gap-2 text-[var(--color-text-muted)] text-xs font-display">
            <div class="w-8 h-[1px] bg-[var(--color-border)]"></div>
            <span>Cloud Native</span>
          </div>
          <div class="absolute -right-4 top-1/3 flex items-center gap-2 text-[var(--color-text-muted)] text-xs font-display">
            <span>Full Stack</span>
            <div class="w-8 h-[1px] bg-[var(--color-border)]"></div>
          </div>
          <div class="absolute -left-4 bottom-1/4 flex items-center gap-2 text-[var(--color-text-muted)] text-xs font-display">
            <div class="w-8 h-[1px] bg-[var(--color-border)]"></div>
            <span>DevOps</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom decorative line -->
  <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-[var(--color-border)] to-transparent"></div>

  <!-- Scroll indicator - subtle -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50">
    <span class="text-[10px] font-display tracking-[0.3em] text-[var(--color-text-muted)] uppercase">Scroll</span>
    <div class="w-[1px] h-8 bg-gradient-to-b from-[var(--color-text-muted)] to-transparent"></div>
  </div>
</section>

<style>
  .perspective-container {
    perspective: 1000px;
  }

  .rotate-3d-box {
    position: relative;
    transform-style: preserve-3d;
    animation: rotate3dSmooth 12s ease-in-out infinite;
  }

  @keyframes rotate3dSmooth {
    0% {
      transform: rotate3d(1, 1, 0, 0deg);
    }
    25% {
      transform: rotate3d(1, 1, 0.5, 15deg);
    }
    50% {
      transform: rotate3d(1, -1, 0, 25deg);
    }
    75% {
      transform: rotate3d(-1, 1, -0.5, 15deg);
    }
    100% {
      transform: rotate3d(1, 1, 0, 0deg);
    }
  }

  /* Orbiting cubes container - positioned to center around the box */
  .orbit-dots-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform-style: preserve-3d;
  }

  .orbit-cube-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }

  /* Cube 1 orbits clockwise with larger radius */
  .orbit-cube-1 {
    animation: orbitClockwise 8s linear infinite;
  }

  /* Cube 2 orbits counter-clockwise with smaller radius */
  .orbit-cube-2 {
    animation: orbitCounterClockwise 6s linear infinite;
  }

  /* 3D Cube structure */
  .cube {
    position: absolute;
    transform-style: preserve-3d;
    transform: translate(-50%, -50%);
    animation: cubeSpin 4s ease-in-out infinite;
  }

  /* Secondary cube (larger) */
  .cube-secondary {
    width: 16px;
    height: 16px;
    /* Offset from center - orbit radius */
    margin-left: 120px;
  }

  /* Primary cube (smaller) */
  .cube-primary {
    width: 12px;
    height: 12px;
    /* Offset from center - different orbit radius */
    margin-left: -90px;
  }

  .cube-face {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* Secondary cube faces */
  .cube-secondary .cube-face {
    background-color: var(--color-accent-secondary);
  }

  /* Primary cube faces */
  .cube-primary .cube-face {
    background-color: var(--color-accent-primary);
  }

  /* Front face */
  .cube-secondary .cube-face-front,
  .cube-primary .cube-face-front {
    transform: translateZ(8px);
  }
  .cube-primary .cube-face-front {
    transform: translateZ(6px);
  }

  /* Back face */
  .cube-secondary .cube-face-back,
  .cube-primary .cube-face-back {
    transform: rotateY(180deg) translateZ(8px);
  }
  .cube-primary .cube-face-back {
    transform: rotateY(180deg) translateZ(6px);
  }

  /* Left face */
  .cube-secondary .cube-face-left,
  .cube-primary .cube-face-left {
    transform: rotateY(-90deg) translateZ(8px);
  }
  .cube-primary .cube-face-left {
    transform: rotateY(-90deg) translateZ(6px);
  }

  /* Right face */
  .cube-secondary .cube-face-right,
  .cube-primary .cube-face-right {
    transform: rotateY(90deg) translateZ(8px);
  }
  .cube-primary .cube-face-right {
    transform: rotateY(90deg) translateZ(6px);
  }

  /* Top face */
  .cube-secondary .cube-face-top,
  .cube-primary .cube-face-top {
    transform: rotateX(90deg) translateZ(8px);
  }
  .cube-primary .cube-face-top {
    transform: rotateX(90deg) translateZ(6px);
  }

  /* Bottom face */
  .cube-secondary .cube-face-bottom,
  .cube-primary .cube-face-bottom {
    transform: rotateX(-90deg) translateZ(8px);
  }
  .cube-primary .cube-face-bottom {
    transform: rotateX(-90deg) translateZ(6px);
  }

  /* Cube self-rotation animation */
  @keyframes cubeSpin {
    0% {
      transform: translate(-50%, -50%) rotateX(0deg) rotateY(0deg);
    }
    50% {
      transform: translate(-50%, -50%) rotateX(180deg) rotateY(180deg);
    }
    100% {
      transform: translate(-50%, -50%) rotateX(360deg) rotateY(360deg);
    }
  }

  @keyframes orbitClockwise {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes orbitCounterClockwise {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(-360deg);
    }
  }

  /* Inner box slow rotation around Z axis */
  .inner-box {
    animation: innerBoxRotate 20s ease-in-out infinite;
  }

  @keyframes innerBoxRotate {
    0% {
      transform: rotate(45deg) rotateZ(0deg);
    }
    50% {
      transform: rotate(45deg) rotateZ(180deg);
    }
    100% {
      transform: rotate(45deg) rotateZ(360deg);
    }
  }

  /* Fixed kube icon - stays in center while box rotates */
  .kube-icon-fixed {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    pointer-events: none;
  }
</style>
