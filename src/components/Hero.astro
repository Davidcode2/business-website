---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = getTranslations(locale);
const isGerman = locale === 'de';
---

<section class="relative min-h-[92vh] flex items-center overflow-hidden pt-24 blueprint-grid">
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Left: Thesis -->
      <div class="lg:col-span-7 space-y-8">
        <div class="flex items-center gap-4 animate-slide-up stagger-1">
          <div class="w-8 h-[2px] bg-[var(--color-accent-primary)]"></div>
          <span class="font-mono text-xs tracking-[0.12em] text-[var(--color-text-muted)] uppercase">
            {t.hero.tagline}
          </span>
        </div>

        <h1 class="font-display text-[2.6rem] sm:text-6xl lg:text-[4.5rem] font-extrabold text-[var(--color-text-primary)] leading-[0.98] tracking-tight animate-slide-up stagger-2">
          <span class="block">{t.hero.headline1}</span>
          <span class="block text-[var(--color-accent-primary)]">{t.hero.headline2}</span>
          <span class="block">{t.hero.headline3}</span>
        </h1>

        <p class="text-lg text-[var(--color-text-secondary)] max-w-xl leading-relaxed animate-slide-up stagger-3">
          {t.hero.subheadline}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 pt-2 animate-slide-up stagger-4">
          <a href="#contact" class="btn-primary group">
            <span>{t.hero.ctaPrimary}</span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="#services" class="btn-secondary">
            <span>{t.hero.ctaSecondary}</span>
          </a>
        </div>
      </div>

      <!-- Right: Typenschild (type plate) — the signature element -->
      <div class="lg:col-span-5 animate-slide-up stagger-3">
        <div class="typeplate max-w-md mx-auto lg:ml-auto p-8 pt-10">
          <span class="rivet-bl"></span>
          <span class="rivet-br"></span>

          <!-- Plate header -->
          <div class="flex items-baseline justify-between border-b-2 border-[var(--color-text-primary)] pb-3 mb-1">
            <span class="font-display text-2xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
              Jakob Lingel
            </span>
            <span class="font-mono text-xs text-[var(--color-accent-primary)] font-semibold">
              JL-2026
            </span>
          </div>

          <!-- Spec rows -->
          <div>
            <div class="spec-row">
              <span class="spec-key">{isGerman ? 'Typ' : 'Type'}</span>
              <span class="spec-val">{isGerman ? 'Software-Ingenieur' : 'Software Engineer'}</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">{isGerman ? 'Standort' : 'Location'}</span>
              <span class="spec-val">Ostalbkreis, BW</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">{isGerman ? 'Erfahrung' : 'Experience'}</span>
              <span class="spec-val">5+ {isGerman ? 'Jahre' : 'years'}</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">{isGerman ? 'Projekte' : 'Projects'}</span>
              <span class="spec-val">20+</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">{isGerman ? 'Antwortzeit' : 'Response time'}</span>
              <span class="spec-val">&lt; 24 h</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">Stack</span>
              <span class="spec-val">AWS · K8s · TS</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">Hosting</span>
              <span class="spec-val">100% DE</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">{isGerman ? 'Verfügbar ab' : 'Available from'}</span>
              <span class="spec-val">{isGerman ? 'sofort' : 'now'}</span>
            </div>
          </div>

          <!-- Plate footer -->
          <div class="mt-5 pt-3 border-t border-[var(--color-border)] flex items-center justify-between gap-3">
            <span class="font-mono text-[10px] tracking-[0.15em] text-[var(--color-text-secondary)] uppercase leading-tight">
              {isGerman ? 'Entwickelt & gehostet in Deutschland' : 'Built & hosted in Germany'}
            </span>
            <svg width="28" height="18" viewBox="0 0 28 18" aria-hidden="true" class="opacity-80 flex-shrink-0 self-center">
              <rect width="28" height="6" fill="#1a1a18"/>
              <rect y="6" width="28" height="6" fill="#e4002b"/>
              <rect y="12" width="28" height="6" fill="#ffcc00"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom hairline -->
  <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-[var(--color-border)]"></div>
</section>
