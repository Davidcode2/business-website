---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
  isServicePage?: boolean;
}

const { locale = 'de', isServicePage = false } = Astro.props;
const t = getTranslations(locale);
const isGerman = locale === 'de';

const homeUrl = isGerman ? "/" : "/en/";
const servicesUrl = isServicePage ? `${homeUrl}#services` : "#services";
const contactUrl = isServicePage ? `${homeUrl}#contact` : "#contact";
const aboutUrl = isServicePage ? `${homeUrl}#about` : "#about";

const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: t.nav.home, href: homeUrl },
  { label: t.nav.about, href: aboutUrl },
  { label: t.nav.services, href: servicesUrl },
  { label: t.nav.contact, href: contactUrl },
  { label: t.nav.impressum, href: isGerman ? "/impressum" : "/en/impressum" },
];
---

<footer class="relative border-t border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14">
    <div class="grid md:grid-cols-12 gap-10">
      <!-- Brand -->
      <div class="md:col-span-5 space-y-4">
        <a href={homeUrl} class="inline-flex items-center gap-3 group">
          <div class="w-9 h-9 bg-[var(--color-text-primary)] rounded-[3px] flex items-center justify-center">
            <span class="font-display text-sm font-extrabold text-[var(--color-bg-primary)]">JL</span>
          </div>
          <div>
            <span class="font-display text-base font-bold text-[var(--color-text-primary)] block leading-tight">Jakob Lingel</span>
            <span class="font-mono text-[10px] tracking-[0.1em] text-[var(--color-text-muted)] uppercase">Digital Solutions</span>
          </div>
        </a>
        <p class="text-[var(--color-text-secondary)] max-w-sm text-sm leading-relaxed">
          {t.footer.tagline}
        </p>
      </div>

      <!-- Navigation -->
      <div class="md:col-span-3">
        <span class="font-mono text-xs tracking-wide text-[var(--color-text-muted)] uppercase block mb-4">Navigation</span>
        <div class="space-y-2.5">
          {footerLinks.map((link) => (
            <a
              href={link.href}
              class="block text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Connect -->
      <div class="md:col-span-4">
        <span class="font-mono text-xs tracking-wide text-[var(--color-text-muted)] uppercase block mb-4">
          {isGerman ? 'Verbinden' : 'Connect'}
        </span>
        <div class="flex gap-3">
          <a
            href="https://github.com/Davidcode2"
            target="_blank"
            rel="noopener noreferrer"
            class="w-11 h-11 border border-[var(--color-border)] rounded-[3px] flex items-center justify-center text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] hover:border-[var(--color-accent-primary)] transition-all"
            aria-label="GitHub"
          >
            <Icon name="simple-icons:github" class="w-5 h-5" />
          </a>
          <a
            href="https://de.linkedin.com/in/jakob-lingel-613976253"
            target="_blank"
            rel="noopener noreferrer"
            class="w-11 h-11 border border-[var(--color-border)] rounded-[3px] flex items-center justify-center text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] hover:border-[var(--color-accent-primary)] transition-all"
            aria-label="LinkedIn"
          >
            <Icon name="simple-icons:linkedin" class="w-5 h-5" />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-[var(--color-border)] flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-[var(--color-text-muted)] text-sm">
        © {currentYear} Jakob Lingel. {t.footer.copyright}
      </p>
      <p class="font-mono text-xs text-[var(--color-text-muted)] tracking-wide">
        AALEN, BW · DE
      </p>
    </div>
  </div>
</footer>
