---
import { Icon } from 'astro-icon/components';

interface Props {
  headline: string;
  description: string;
  features: Array<{
    title: string;
    description: string;
    icon?: string;
  }>;
}

const { headline, description, features } = Astro.props;
---

<section class="py-24 sm:py-32 relative border-t border-[var(--color-border)]">
  <!-- Background -->
  <div class="absolute inset-0 bg-[var(--color-bg-secondary)]"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <!-- Left: Features -->
      <div class="space-y-6">
        {features.map((feature, index) => (
          <div class="service-card group">
            <div class="flex items-start gap-4">
              <!-- Number indicator -->
              <div class="flex-shrink-0 w-10 h-10 border border-[var(--color-border)] flex items-center justify-center group-hover:border-[var(--color-accent-primary)] transition-colors">
                <span class="font-display text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-primary)] transition-colors">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <div>
                <h3 class="font-display text-lg font-semibold text-[var(--color-text-primary)] mb-1">
                  {feature.title}
                </h3>
                <p class="text-[var(--color-text-secondary)] font-body">
                  {feature.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Right: Content -->
      <div class="lg:sticky lg:top-32 space-y-6">
        <!-- Section Marker -->
        <div class="flex items-center gap-4">
          <div class="w-8 h-[1px] bg-[var(--color-accent-primary)]"></div>
          <span class="font-display text-xs tracking-[0.3em] text-[var(--color-accent-primary)] uppercase">
            The Solution
          </span>
        </div>

        <h2 class="font-display text-3xl sm:text-4xl font-bold text-[var(--color-text-primary)] leading-[1]">
          <span class="gradient-text">{headline}</span>
        </h2>

        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed font-body">
          {description}
        </p>

        <!-- Technical decoration -->
        <div class="pt-6 border-t border-[var(--color-border)] flex items-center gap-4 text-[var(--color-text-muted)] font-display text-xs tracking-wider">
          <span>IMPLEMENTATION</span>
          <div class="flex-1 h-[1px] bg-[var(--color-border)]"></div>
          <span>READY</span>
        </div>
      </div>
    </div>
  </div>
</section>
