---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  tagline: string;
  description: string;
  icon: string;
  serviceCode?: string;
}

const { title, tagline, description, icon, serviceCode = "SRV-001" } = Astro.props;
---

<section class="relative min-h-[70vh] flex items-center overflow-hidden py-24 sm:py-32 blueprint-grid">
  <!-- Decorative Elements -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Vertical lines -->
    <div class="absolute left-[15%] top-0 bottom-0 w-[1px] bg-[var(--color-border)]"></div>
    <div class="absolute right-[20%] top-0 bottom-0 w-[1px] bg-[var(--color-border)]"></div>
    <!-- Corner markers -->
    <div class="absolute top-32 left-8 w-16 h-16 border-l-2 border-t-2 border-[var(--color-accent-primary)] opacity-30"></div>
    <div class="absolute bottom-32 right-8 w-16 h-16 border-r-2 border-b-2 border-[var(--color-accent-primary)] opacity-30"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-8">
    <!-- Service Code -->
    <div class="flex items-center justify-center gap-4 mb-8">
      <div class="w-12 h-[1px] bg-[var(--color-accent-secondary)]"></div>
      <span class="font-display text-xs tracking-[0.3em] text-[var(--color-accent-secondary)] uppercase">
        {serviceCode}
      </span>
      <div class="w-12 h-[1px] bg-[var(--color-accent-secondary)]"></div>
    </div>

    <!-- Icon -->
    <div class="flex justify-center mb-8">
      <div class="w-20 h-20 border border-[var(--color-border)] flex items-center justify-center relative">
        <Icon name={icon} class="w-10 h-10 text-[var(--color-accent-primary)]" />
        <!-- Corner accent -->
        <div class="absolute top-0 right-0 w-4 h-4 border-t border-r border-[var(--color-accent-primary)]"></div>
        <div class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-[var(--color-accent-primary)]"></div>
      </div>
    </div>

    <!-- Tagline -->
    <p class="text-[var(--color-accent-secondary)] font-display text-sm tracking-[0.2em] uppercase text-center mb-4">
      {tagline}
    </p>

    <!-- Title -->
    <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-[var(--color-text-primary)] mb-6 leading-[0.95] text-center">
      <span class="gradient-text">{title}</span>
    </h1>

    <!-- Description -->
    <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] max-w-3xl mx-auto leading-relaxed text-center mb-10 font-body">
      {description}
    </p>

    <!-- CTA -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="#contact"
        class="btn-primary group"
      >
        <span>Get Started</span>
        <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
      <a
        href="#process"
        class="btn-secondary"
      >
        How It Works
      </a>
    </div>
  </div>
</section>
