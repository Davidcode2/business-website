---
import { Icon } from 'astro-icon/components';

interface Props {
  headline: string;
  description: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  headline,
  description,
  buttonText = "Get Started",
  buttonHref = "#contact"
} = Astro.props;
---

<section id="contact" class="py-24 sm:py-32 relative overflow-hidden border-t border-[var(--color-border)]">
  <!-- Background Elements -->
  <div class="absolute inset-0 blueprint-grid opacity-20"></div>

  <!-- Decorative corner markers -->
  <div class="absolute top-8 left-8 w-16 h-16 border-l-2 border-t-2 border-[var(--color-accent-primary)] opacity-20"></div>
  <div class="absolute bottom-8 right-8 w-16 h-16 border-r-2 border-b-2 border-[var(--color-accent-primary)] opacity-20"></div>

  <div class="relative max-w-4xl mx-auto px-6 lg:px-8 text-center">
    <!-- Section Marker -->
    <div class="flex items-center justify-center gap-4 mb-6">
      <div class="w-12 h-[1px] bg-[var(--color-accent-secondary)]"></div>
      <span class="font-display text-xs tracking-[0.3em] text-[var(--color-accent-secondary)] uppercase">
        Next Steps
      </span>
      <div class="w-12 h-[1px] bg-[var(--color-accent-secondary)]"></div>
    </div>

    <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text-primary)] mb-6 leading-[0.95]">
      <span class="gradient-text-warm">{headline}</span>
    </h2>

    <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] mb-10 max-w-2xl mx-auto font-body">
      {description}
    </p>

    <a
      href={buttonHref}
      class="btn-primary group"
    >
      <span>{buttonText}</span>
      <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
    </a>
  </div>
</section>
