---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = getTranslations(locale);
const isGerman = locale === 'de';

const services = [
  {
    icon: "lucide:brain",
    title: t.services.aiEnablement.title,
    description: t.services.aiEnablement.description,
    href: isGerman ? "/services/ai-enablement" : "/en/services/ai-enablement",
    ref: "KI",
  },
  {
    icon: "lucide:code",
    title: t.services.webDevelopment.title,
    description: t.services.webDevelopment.description,
    href: isGerman ? "/services/web-development" : "/en/services/web-development",
    ref: "WEB",
  },
  {
    icon: "lucide:cloud",
    title: t.services.cloudDevops.title,
    description: t.services.cloudDevops.description,
    href: isGerman ? "/services/cloud-devops" : "/en/services/cloud-devops",
    ref: "CLD",
  },
  {
    icon: "lucide:shield",
    title: t.services.security.title,
    description: t.services.security.description,
    href: isGerman ? "/services/security" : "/en/services/security",
    ref: "SEC",
  }
];
---

<section id="services" class="relative py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section header: label column + headline -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 mb-16">
      <div class="lg:col-span-3">
        <div class="section-marker">
          <span>{t.services.sectionTagline}</span>
        </div>
      </div>
      <div class="lg:col-span-9 space-y-5">
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-[var(--color-text-primary)] leading-[1.05] tracking-tight">
          {t.services.sectionTitle1}
          <span class="text-[var(--color-accent-primary)]">{t.services.sectionTitle2}</span>
        </h2>
        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-2xl">
          {t.services.sectionDescription}
        </p>
      </div>
    </div>

    <!-- Services: bordered table rows -->
    <div class="border-t border-[var(--color-border)]">
      {services.map((service) => (
        <a
          href={service.href}
          class="group grid lg:grid-cols-12 gap-2 lg:gap-6 items-baseline py-7 border-b border-[var(--color-border)] hover:bg-[var(--color-bg-elevated)] transition-colors px-2 lg:px-4 -mx-2 lg:-mx-4"
        >
          <!-- Ref code -->
          <div class="lg:col-span-1 lg:pt-[3px]">
            <span class="font-mono text-xs font-semibold tracking-widest text-[var(--color-accent-primary)] border border-[var(--color-border)] group-hover:border-[var(--color-accent-primary)] px-1.5 py-0.5 transition-colors inline-block">
              {service.ref}
            </span>
          </div>

          <!-- Title -->
          <div class="lg:col-span-5">
            <h3 class="font-display text-xl font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-primary)] transition-colors leading-tight">
              {service.title}
            </h3>
          </div>

          <!-- Description -->
          <div class="lg:col-span-5">
            <p class="text-[15px] text-[var(--color-text-secondary)] leading-relaxed">
              {service.description}
            </p>
          </div>

          <!-- Arrow -->
          <div class="hidden lg:flex lg:col-span-1 justify-end items-center">
            <Icon name="lucide:arrow-right" class="w-5 h-5 text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-primary)] group-hover:translate-x-1 transition-all" />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
