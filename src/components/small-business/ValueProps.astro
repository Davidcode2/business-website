---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  items: {
    design: { title: string; description: string };
    hosting: { title: string; description: string };
    updates: { title: string; description: string };
  };
}

const { title, items } = Astro.props;

const features = [
  { icon: "lucide:monitor", ...items.design },
  { icon: "lucide:server", ...items.hosting },
  { icon: "lucide:shield", ...items.updates },
];
---

<section class="relative py-16 sm:py-20 border-t border-[var(--color-border)]">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <div class="flex items-center justify-center gap-4 mb-4">
        <div class="w-8 h-[1px] bg-[var(--color-accent-primary)]"></div>
        <span class="font-display text-xs tracking-[0.3em] text-[var(--color-accent-primary)] uppercase">
          {title}
        </span>
        <div class="w-8 h-[1px] bg-[var(--color-accent-primary)]"></div>
      </div>
    </div>

    <!-- 3 Items Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {features.map((feature, index) => (
        <div class="relative p-6 border border-[var(--color-border)] bg-[var(--color-bg-secondary)] group hover:border-[var(--color-accent-primary)] transition-colors duration-300">
          <!-- Corner accent -->
          <div class="absolute top-0 right-0 w-6 h-6 border-t border-r border-[var(--color-accent-primary)] opacity-0 group-hover:opacity-100 transition-opacity"></div>
          
          <!-- Number -->
          <span class="absolute top-4 left-4 font-display text-4xl font-bold text-[var(--color-text-muted)] opacity-20">
            0{index + 1}
          </span>
          
          <!-- Icon -->
          <div class="mb-4 mt-8">
            <Icon name={feature.icon} class="w-8 h-8 text-[var(--color-accent-primary)]" />
          </div>
          
          <!-- Title -->
          <h3 class="font-display text-lg font-semibold text-[var(--color-text-primary)] mb-2">
            {feature.title}
          </h3>
          
          <!-- Description -->
          <p class="text-sm text-[var(--color-text-secondary)] font-body leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
