            <div class="tech-item">
              <Icon name="simple-icons:archlinux" class="w-10 h-10" />
              <span>Arch Linux</span>
            </div>
          </div>
        </div>

        <!-- Row 2: Scrolling right -->
        <div class="marquee-row">
          <div class="marquee-content-reverse">
            <!-- First set -->
            <div class="tech-item">
              <Icon name="simple-icons:kubernetes" class="w-10 h-10" />
              <span>Kubernetes</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:terraform" class="w-10 h-10" />
