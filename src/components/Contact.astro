---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = getTranslations(locale);
---

<section id="contact" class="py-24 sm:py-32 relative">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-(--color-accent-subtle)/10 to-transparent"></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-12">
      <p class="text-(--color-accent) font-medium mb-4 tracking-wide uppercase text-sm">
        {t.contact.sectionTagline}
      </p>
      <h2 class="text-4xl sm:text-5xl font-bold text-(--color-text-primary) mb-6">
        {t.contact.sectionTitle1}
        <span class="gradient-text">{t.contact.sectionTitle2}</span>
      </h2>
      <p class="text-lg text-(--color-text-secondary) max-w-2xl mx-auto">
        {t.contact.description}
      </p>
    </div>

    <!-- Contact Form -->
    <div class="max-w-2xl mx-auto">
      <form
        name="contact"
        id="contact-form"
        class="space-y-6 text-left"
      >
        <input type="hidden" name="site_id" value="business-website" />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="_website" tabindex="-1" autocomplete="off" /></label>
        </p>

        <!-- Name Field -->
        <div>
          <label for="name" class="block text-sm font-medium text-(--color-text-secondary) mb-2">
            {t.contact.form.name} *
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-3 rounded-lg bg-(--color-bg-secondary) border border-(--color-border) text-(--color-text-primary) placeholder-(--color-text-muted) focus:outline-none focus:ring-2 focus:ring-(--color-accent) focus:border-transparent transition-all"
            placeholder={t.contact.form.namePlaceholder}
          />
        </div>

        <!-- Email Field -->
        <div>
          <label for="email" class="block text-sm font-medium text-(--color-text-secondary) mb-2">
            {t.contact.form.email} *
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-lg bg-(--color-bg-secondary) border border-(--color-border) text-(--color-text-primary) placeholder-(--color-text-muted) focus:outline-none focus:ring-2 focus:ring-(--color-accent) focus:border-transparent transition-all"
            placeholder={t.contact.form.emailPlaceholder}
          />
        </div>

        <!-- Message Field -->
        <div>
          <label for="message" class="block text-sm font-medium text-(--color-text-secondary) mb-2">
            {t.contact.form.message} *
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="w-full px-4 py-3 rounded-lg bg-(--color-bg-secondary) border border-(--color-border) text-(--color-text-primary) placeholder-(--color-text-muted) focus:outline-none focus:ring-2 focus:ring-(--color-accent) focus:border-transparent transition-all resize-none"
            placeholder={t.contact.form.messagePlaceholder}
          ></textarea>
        </div>

        <!-- Success/Error Messages -->
        <div id="form-success" class="hidden p-4 rounded-lg bg-green-500/10 border border-green-500/20 text-green-600">
          <p>{t.contact.form.successMessage}</p>
        </div>
        <div id="form-error" class="hidden p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-red-600">
          <p id="error-message">{t.contact.form.errorMessage}</p>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          id="submit-btn"
          class="w-full py-4 px-8 bg-(--color-accent) text-(--color-text-inverse) rounded-full font-medium hover:bg-(--color-accent-emphasis) transition-all hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 flex items-center justify-center gap-2"
        >
          <Icon name="lucide:send" class="w-5 h-5" />
          <span id="btn-text">{t.contact.form.submit}</span>
          <span id="btn-loading" class="hidden">
            <svg class="animate-spin h-5 w-5 text-(--color-text-inverse)" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>{t.contact.form.sending}</span>
          </span>
        </button>
      </form>
    </div>

    <!-- Technology Stack Marquee -->
    <div class="mt-20">
      <p class="text-center text-sm text-(--color-text-muted) mb-8">{t.contact.trustedTech}</p>
      <div class="space-y-8">
        <!-- Row 1: Scrolling left -->
        <div class="marquee-row">
          <div class="marquee-content">
            <!-- First set -->
            <div class="tech-item">
              <Icon name="simple-icons:astro" class="w-10 h-10" />
              <span>Astro</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:react" class="w-10 h-10" />
              <span>React</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:typescript" class="w-10 h-10" />
              <span>TypeScript</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:angular" class="w-10 h-10" />
              <span>Angular</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:nextdotjs" class="w-10 h-10" />
              <span>Next.js</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:nestjs" class="w-10 h-10" />
              <span>NestJS</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:tailwindcss" class="w-10 h-10" />
              <span>Tailwind CSS</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:python" class="w-10 h-10" />
              <span>Python</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:dotnet" class="w-10 h-10" />
