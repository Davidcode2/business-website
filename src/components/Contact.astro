            </div>
            <div class="tech-item">
              <Icon name="simple-icons:neovim" class="w-10 h-10" />
              <span>Neovim</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:archlinux" class="w-10 h-10" />
              <span>Arch Linux</span>
            </div>

            <!-- Duplicate for seamless loop -->
            <div class="tech-item">
              <Icon name="simple-icons:astro" class="w-10 h-10" />
              <span>Astro</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:react" class="w-10 h-10" />
              <span>React</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:typescript" class="w-10 h-10" />
              <span>TypeScript</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:angular" class="w-10 h-10" />
              <span>Angular</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:nextdotjs" class="w-10 h-10" />
              <span>Next.js</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:nestjs" class="w-10 h-10" />
              <span>NestJS</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:tailwindcss" class="w-10 h-10" />
