---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = getTranslations(locale);
const isGerman = locale === 'de';
---

<section id="contact" class="relative py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16">

      <!-- Label column -->
      <div class="lg:col-span-3">
        <div class="section-marker">
          <span>{t.contact.sectionTagline}</span>
        </div>
      </div>

      <!-- Content -->
      <div class="lg:col-span-9">
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-[var(--color-text-primary)] leading-[1.05] tracking-tight mb-6">
          {t.contact.sectionTitle1}
          <span class="text-[var(--color-accent-primary)]">{t.contact.sectionTitle2}</span>
        </h2>

        <p class="text-lg text-[var(--color-text-secondary)] max-w-2xl mb-12">
          {t.contact.description}
        </p>

        <div class="grid lg:grid-cols-5 gap-10">
          <!-- Form -->
          <div class="lg:col-span-3">
            <form name="contact" id="contact-form" class="space-y-6">
              <input type="hidden" name="site_id" value="business-website" />
              <p class="hidden">
                <label>Don't fill this out if you're human: <input name="_website" tabindex="-1" autocomplete="off" /></label>
              </p>

              <div class="grid sm:grid-cols-2 gap-5">
                <div class="space-y-2">
                  <label for="name" class="block font-mono text-xs tracking-wide text-[var(--color-text-muted)] uppercase">
                    {t.contact.form.name} *
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="tech-input"
                    placeholder={t.contact.form.namePlaceholder}
                  />
                </div>
                <div class="space-y-2">
                  <label for="email" class="block font-mono text-xs tracking-wide text-[var(--color-text-muted)] uppercase">
                    {t.contact.form.email} *
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="tech-input"
                    placeholder={t.contact.form.emailPlaceholder}
                  />
                </div>
              </div>

              <div class="space-y-2">
                <label for="message" class="block font-mono text-xs tracking-wide text-[var(--color-text-muted)] uppercase">
                  {t.contact.form.message} *
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  class="tech-input resize-none"
                  placeholder={t.contact.form.messagePlaceholder}
                ></textarea>
              </div>

              <div id="form-success" class="hidden p-4 border border-green-600/40 bg-green-600/10 rounded-[3px]">
                <div class="flex items-center gap-3">
                  <Icon name="lucide:check-circle" class="w-5 h-5 text-green-700" />
                  <p class="text-[var(--color-text-primary)]">{t.contact.form.successMessage}</p>
                </div>
              </div>

              <div id="form-error" class="hidden p-4 border border-red-500/40 bg-red-500/10 rounded-[3px]">
                <div class="flex items-center gap-3">
                  <Icon name="lucide:alert-circle" class="w-5 h-5 text-red-600" />
                  <p id="error-message" class="text-red-600">{t.contact.form.errorMessage}</p>
                </div>
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="btn-primary w-full sm:w-auto justify-center"
              >
                <Icon name="lucide:send" class="w-4 h-4" />
                <span id="btn-text">{t.contact.form.submit}</span>
                <span id="btn-loading" class="hidden flex items-center gap-2">
                  <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span>{t.contact.form.sending}</span>
                </span>
              </button>

              <p class="font-mono text-sm text-[var(--color-text-secondary)]">
                {isGerman ? 'Antwort in der Regel innerhalb von 24 Stunden.' : 'I usually reply within 24 hours.'}
              </p>
            </form>
          </div>

          <!-- Side panel: how to reach me + stack -->
          <div class="lg:col-span-2">
            <div class="typeplate p-6 pt-7">
              <span class="rivet-bl"></span>
              <span class="rivet-br"></span>
              <span class="block font-display font-bold text-[var(--color-text-primary)] border-b-2 border-[var(--color-text-primary)] pb-2 mb-1">
                {isGerman ? 'Direkt' : 'Direct'}
              </span>
              <div class="spec-row"><span class="spec-key">{isGerman ? 'Antwort' : 'Reply'}</span><span class="spec-val">&lt; 24 h</span></div>
              <div class="spec-row"><span class="spec-key">{isGerman ? 'Standort' : 'Location'}</span><span class="spec-val">Ostalbkreis, BW</span></div>
              <div class="spec-row"><span class="spec-key">{isGerman ? 'Erstgespräch' : 'Intro call'}</span><span class="spec-val">{isGerman ? 'kostenlos' : 'free'}</span></div>

              <div class="mt-5 pt-4 border-t border-[var(--color-border)]">
                <span class="spec-key block mb-3">Stack</span>
                <p class="font-mono text-xs leading-relaxed text-[var(--color-text-secondary)]">
                  Astro · React · TS · NestJS · Python · AWS · K8s · Terraform
                </p>
              </div>

              <div class="mt-5 pt-4 border-t border-[var(--color-border)]">
                <span class="spec-key block mb-3">{isGerman ? 'Profile' : 'Profiles'}</span>
                <div class="flex gap-3">
                  <a
                    href="https://github.com/Davidcode2"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-11 h-11 border border-[var(--color-border)] rounded-[3px] flex items-center justify-center text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] hover:border-[var(--color-accent-primary)] transition-all"
                    aria-label="GitHub"
                  >
                    <Icon name="simple-icons:github" class="w-5 h-5" />
                  </a>
                  <a
                    href="https://de.linkedin.com/in/jakob-lingel-613976253"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-11 h-11 border border-[var(--color-border)] rounded-[3px] flex items-center justify-center text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] hover:border-[var(--color-accent-primary)] transition-all"
                    aria-label="LinkedIn"
                  >
                    <Icon name="simple-icons:linkedin" class="w-5 h-5" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnLoading = document.getElementById('btn-loading');
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');
  const errorText = document.getElementById('error-message');

  const API_URL = import.meta.env.PUBLIC_MESSAGE_ROUTER_URL || 'https://notifications.jakob-lingel.dev/v1/submit';
  const API_KEY = import.meta.env.PUBLIC_MESSAGE_ROUTER_API_KEY || '';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    if (submitBtn) {
      (submitBtn as HTMLButtonElement).disabled = true;
    }
    btnText?.classList.add('hidden');
    btnLoading?.classList.remove('hidden');

    try {
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      if (data._website) {
        console.log('Honeypot triggered');
        successMsg?.classList.remove('hidden');
        form.reset();
        return;
      }

      const response = await fetch(API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-api-key': API_KEY,
        },
        body: JSON.stringify({
          site_id: data.site_id,
          name: data.name,
          email: data.email,
          message: data.message,
        }),
      });

      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        throw new Error(errorData.message || `HTTP ${response.status}`);
      }

      const result = await response.json();

      if (result.success) {
        successMsg?.classList.remove('hidden');
        form.reset();
      } else {
        throw new Error(result.message || 'Unknown error');
      }
    } catch (error) {
      console.error('Form submission error:', error);
      if (errorText) {
        errorText.textContent = (error as Error).message || 'An error occurred. Please try again later.';
      }
      errorMsg?.classList.remove('hidden');
    } finally {
      if (submitBtn) {
        (submitBtn as HTMLButtonElement).disabled = false;
      }
      btnText?.classList.remove('hidden');
      btnLoading?.classList.add('hidden');
    }
  });
</script>
