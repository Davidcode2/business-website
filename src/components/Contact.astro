              <span>Neovim</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:archlinux" class="w-10 h-10" />
              <span>Arch Linux</span>
            </div>

            <!-- Duplicate for seamless loop -->
            <div class="tech-item">
              <Icon name="simple-icons:astro" class="w-10 h-10" />
              <span>Astro</span>
            </div>
            <div class="tech-item">
              <Icon name="simple-icons:react" class="w-10 h-10" />
