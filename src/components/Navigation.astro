---
import { Icon } from 'astro-icon/components';

interface Props {
  currentLocale?: string;
  currentPath?: string;
  isServicePage?: boolean;
}

const { currentLocale = 'de', currentPath = '', isServicePage = false } = Astro.props;

const isGerman = currentLocale === 'de';
const alternateLocale = isGerman ? 'en' : 'de';

let alternatePath = currentPath;
if (alternateLocale === 'en') {
  alternatePath = '/en' + currentPath;
} else {
  alternatePath = currentPath.replace(/^\/en/, '') || '/';
}

const homeUrl = isGerman ? "/" : "/en/";
const servicesUrl = isServicePage ? `${homeUrl}#services` : "#services";
const contactUrl = isServicePage ? `${homeUrl}#contact` : "#contact";
const aboutUrl = isServicePage ? `${homeUrl}#about` : "#about";

const navLinks = [
  { label: isGerman ? 'Leistungen' : 'Services', href: servicesUrl },
  { label: isGerman ? 'Profil' : 'Profile', href: aboutUrl },
  { label: isGerman ? 'Kontakt' : 'Contact', href: contactUrl },
];

const serviceLinks = [
  { label: isGerman ? 'KI-Integration' : 'AI Integration', href: isGerman ? '/services/ai-enablement' : '/en/services/ai-enablement', ref: 'KI' },
  { label: isGerman ? 'Webentwicklung' : 'Web Development', href: isGerman ? '/services/web-development' : '/en/services/web-development', ref: 'WEB' },
  { label: isGerman ? 'Cloud & DevOps' : 'Cloud & DevOps', href: isGerman ? '/services/cloud-devops' : '/en/services/cloud-devops', ref: 'CLD' },
  { label: isGerman ? 'Security' : 'Security', href: isGerman ? '/services/security' : '/en/services/security', ref: 'SEC' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-[var(--color-bg-primary)]/85 border-b border-[var(--color-border)]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-[72px]">
      <!-- Logo -->
      <a href={homeUrl} class="group flex items-center gap-3">
        <div class="w-9 h-9 bg-[var(--color-text-primary)] rounded-[3px] flex items-center justify-center">
          <span class="font-display text-sm font-extrabold text-[var(--color-bg-primary)]">JL</span>
        </div>
        <div class="hidden sm:block">
          <span class="font-display text-base font-bold text-[var(--color-text-primary)] tracking-tight block leading-tight">Jakob Lingel</span>
          <span class="font-mono text-[10px] tracking-[0.1em] text-[var(--color-text-muted)] uppercase">Digital Solutions</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-7">
        <button
          id="services-popover-trigger"
          class="flex items-center gap-1.5 py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] font-display text-sm font-medium transition-colors"
          aria-expanded="false"
          aria-controls="services-popover"
        >
          <span>{isGerman ? 'Leistungen' : 'Services'}</span>
          <Icon name="lucide:chevron-down" class="w-4 h-4 transition-transform" id="services-chevron" />
        </button>

        {navLinks.slice(1).map((link) => (
          <a
            href={link.href}
            class="py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] font-display text-sm font-medium transition-colors relative group"
          >
            {link.label}
            <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[var(--color-accent-primary)] group-hover:w-full transition-all duration-200"></span>
          </a>
        ))}

        <a href={contactUrl} class="btn-primary !py-2 !px-4 !text-sm">
          {isGerman ? 'Gespräch vereinbaren' : "Let's talk"}
        </a>

        <div class="w-[1px] h-5 bg-[var(--color-border)]"></div>

        <!-- Language Toggle -->
        <a
          href={alternatePath}
          class="flex items-center gap-1.5 font-mono text-xs"
          aria-label={isGerman ? 'Switch to English' : 'Zu Deutsch wechseln'}
        >
          <span class={isGerman ? 'text-[var(--color-accent-primary)] font-semibold' : 'text-[var(--color-text-muted)]'}>DE</span>
          <span class="text-[var(--color-border)]">/</span>
          <span class={!isGerman ? 'text-[var(--color-accent-primary)] font-semibold' : 'text-[var(--color-text-muted)]'}>EN</span>
        </a>

        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] transition-colors"
          aria-label="Toggle theme"
        >
          <Icon name="lucide:sun" class="w-5 h-5 hidden dark-icon" />
          <Icon name="lucide:moon" class="w-5 h-5 light-icon" />
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]"
        aria-label="Open menu"
      >
        <Icon name="lucide:menu" class="w-6 h-6" id="menu-open-icon" />
        <Icon name="lucide:x" class="w-6 h-6 hidden" id="menu-close-icon" />
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[var(--color-border)] bg-[var(--color-bg-primary)]">
    <div class="px-6 py-6 space-y-5">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block font-display text-xl font-bold text-[var(--color-text-primary)] hover:text-[var(--color-accent-primary)] transition-colors"
        >
          {link.label}
        </a>
      ))}

      <div class="pt-4 border-t border-[var(--color-border-subtle)]">
        <span class="font-mono text-xs tracking-wide text-[var(--color-text-muted)] uppercase block mb-3">
          {isGerman ? 'Leistungen' : 'Services'}
        </span>
        <div class="space-y-2.5">
          {serviceLinks.map((service) => (
            <a
              href={service.href}
              class="flex items-center gap-3 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] transition-colors"
            >
              <span class="font-mono text-[10px] text-[var(--color-text-muted)]">{service.ref}</span>
              <span>{service.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="pt-5 border-t border-[var(--color-border)]">
        <a href={contactUrl} class="btn-primary w-full justify-center">
          {isGerman ? 'Gespräch vereinbaren' : "Let's talk"}
        </a>
      </div>

      <div class="pt-4 flex items-center justify-between">
        <a href={alternatePath} class="flex items-center gap-1.5 font-mono text-sm">
          <span class={isGerman ? 'text-[var(--color-accent-primary)] font-semibold' : 'text-[var(--color-text-muted)]'}>DE</span>
          <span class="text-[var(--color-border)]">/</span>
          <span class={!isGerman ? 'text-[var(--color-accent-primary)] font-semibold' : 'text-[var(--color-text-muted)]'}>EN</span>
        </a>

        <button
          id="mobile-theme-toggle"
          class="p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] transition-colors"
          aria-label="Toggle theme"
        >
          <Icon name="lucide:sun" class="w-5 h-5 hidden dark-icon" />
          <Icon name="lucide:moon" class="w-5 h-5 light-icon" />
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Services Popover: simple dropdown panel -->
<div
  id="services-popover-overlay"
  class="fixed inset-0 z-40 opacity-0 invisible transition-opacity duration-200"
  aria-hidden="true"
></div>

<div
  id="services-popover"
  class="fixed left-1/2 -translate-x-1/2 top-20 z-50 opacity-0 invisible transition-all duration-200 translate-y-2"
  role="dialog"
  aria-modal="true"
  aria-labelledby="services-popover-title"
>
  <div class="typeplate p-0 w-[440px] max-w-[92vw] overflow-hidden">
    <span class="rivet-bl"></span>
    <span class="rivet-br"></span>

    <div class="px-6 pt-6 pb-4 border-b border-[var(--color-border)] flex items-center justify-between">
      <h2 id="services-popover-title" class="font-display text-lg font-bold text-[var(--color-text-primary)]">
        {isGerman ? 'Leistungen' : 'Services'}
      </h2>
      <button
        id="services-popover-close"
        class="p-1.5 text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] transition-colors"
        aria-label="Close"
      >
        <Icon name="lucide:x" class="w-4 h-4" />
      </button>
    </div>

    <div>
      {serviceLinks.map((service) => (
        <a
          href={service.href}
          class="group flex items-center justify-between px-6 py-4 border-b border-[var(--color-border-subtle)] last:border-b-0 hover:bg-[var(--color-bg-secondary)] transition-colors"
        >
          <div class="flex items-center gap-4">
            <span class="font-mono text-[10px] text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-primary)] transition-colors w-8">
              {service.ref}
            </span>
            <span class="font-display font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-primary)] transition-colors">
              {service.label}
            </span>
          </div>
          <Icon name="lucide:arrow-right" class="w-4 h-4 text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-primary)] group-hover:translate-x-1 transition-all" />
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  /* Theme icon swap based on current theme */
  :global([data-theme="light"]) .light-icon { display: block; }
  :global([data-theme="light"]) .dark-icon { display: none; }
  :global([data-theme="dark"]) .light-icon { display: none; }
  :global([data-theme="dark"]) .dark-icon { display: block; }
</style>

<script>
  function toggleTheme() {
    const html = document.documentElement;
    const currentTheme = html.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('mobile-theme-toggle')?.addEventListener('click', toggleTheme);

  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  menuBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    if (isHidden) {
      mobileMenu?.classList.remove('hidden');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      mobileMenu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  const servicesTrigger = document.getElementById('services-popover-trigger');
  const servicesPopover = document.getElementById('services-popover');
  const servicesOverlay = document.getElementById('services-popover-overlay');
  const servicesClose = document.getElementById('services-popover-close');
  const servicesChevron = document.getElementById('services-chevron');

  function openServicesPopover() {
    servicesPopover?.classList.remove('opacity-0', 'invisible', 'translate-y-2');
    servicesOverlay?.classList.remove('opacity-0', 'invisible');
    servicesChevron?.classList.add('rotate-180');
    servicesTrigger?.setAttribute('aria-expanded', 'true');
  }

  function closeServicesPopover() {
    servicesPopover?.classList.add('opacity-0', 'invisible', 'translate-y-2');
    servicesOverlay?.classList.add('opacity-0', 'invisible');
    servicesChevron?.classList.remove('rotate-180');
    servicesTrigger?.setAttribute('aria-expanded', 'false');
  }

  servicesTrigger?.addEventListener('click', () => {
    const isExpanded = servicesTrigger.getAttribute('aria-expanded') === 'true';
    if (isExpanded) closeServicesPopover(); else openServicesPopover();
  });

  servicesClose?.addEventListener('click', closeServicesPopover);
  servicesOverlay?.addEventListener('click', closeServicesPopover);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeServicesPopover();
  });

  servicesPopover?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeServicesPopover);
  });
</script>
