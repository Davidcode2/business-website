---
import { Icon } from 'astro-icon/components';

interface Props {
  currentLocale?: string;
  currentPath?: string;
  isServicePage?: boolean;
}

const { currentLocale = 'de', currentPath = '', isServicePage = false } = Astro.props;

const isGerman = currentLocale === 'de';
const alternateLocale = isGerman ? 'en' : 'de';

// Build the alternate URL path
let alternatePath = currentPath;
if (alternateLocale === 'en') {
  alternatePath = '/en' + currentPath;
} else {
  alternatePath = currentPath.replace(/^\/en/, '') || '/';
}

const homeUrl = isGerman ? "/" : "/en/";
const servicesUrl = isServicePage ? `${homeUrl}#services` : "#services";
const contactUrl = isServicePage ? `${homeUrl}#contact` : "#contact";
const aboutUrl = isServicePage ? `${homeUrl}#about` : "#about";

const navLinks = [
  { label: isGerman ? 'Leistungen' : 'Services', href: servicesUrl },
  { label: isGerman ? 'Profil' : 'Profile', href: aboutUrl },
  { label: isGerman ? 'Kontakt' : 'Contact', href: contactUrl },
];

const serviceLinks = [
  { label: isGerman ? 'KI-Integration' : 'AI Integration', href: isGerman ? '/services/ai-enablement' : '/en/services/ai-enablement' },
  { label: isGerman ? 'Webentwicklung' : 'Web Development', href: isGerman ? '/services/web-development' : '/en/services/web-development' },
  { label: isGerman ? 'Cloud & DevOps' : 'Cloud & DevOps', href: isGerman ? '/services/cloud-devops' : '/en/services/cloud-devops' },
  { label: isGerman ? 'Security' : 'Security', href: isGerman ? '/services/security' : '/en/services/security' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-[var(--color-bg-primary)]/80 border-b border-[var(--color-border)]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo - Technical monospace feel -->
      <a href={homeUrl} class="group flex items-center gap-3">
        <div class="w-10 h-10 border border-[var(--color-accent-primary)] flex items-center justify-center relative overflow-hidden">
          <span class="font-display text-lg font-bold text-[var(--color-accent-primary)]">JL</span>
          <div class="absolute inset-0 bg-[var(--color-accent-primary)] opacity-0 group-hover:opacity-10 transition-opacity"></div>
        </div>
        <div class="hidden sm:block">
          <span class="font-display text-lg font-semibold text-[var(--color-text-primary)] tracking-tight block">Jakob Lingel</span>
          <span class="font-display text-[10px] tracking-[0.2em] text-[var(--color-text-muted)] uppercase">Digital Solutions</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        <!-- Services Popover Trigger -->
        <button
          id="services-popover-trigger"
          class="flex items-center gap-2 py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] font-display text-sm tracking-wide transition-colors"
          aria-expanded="false"
          aria-controls="services-popover"
        >
          <span>{isGerman ? 'Leistungen' : 'Services'}</span>
          <Icon name="lucide:chevron-down" class="w-4 h-4 transition-transform" id="services-chevron" />
        </button>

        {navLinks.slice(1).map((link) => (
          <a
            href={link.href}
            class="py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] font-display text-sm tracking-wide transition-colors relative group"
          >
            {link.label}
            <span class="absolute bottom-0 left-0 w-0 h-[1px] bg-[var(--color-accent-primary)] group-hover:w-full transition-all duration-300"></span>
          </a>
        ))}

        <!-- Divider -->
        <div class="w-[1px] h-6 bg-[var(--color-border)]"></div>

        <!-- Language Toggle -->
        <a
          href={alternatePath}
          class="flex items-center gap-2 font-display text-xs tracking-wider"
          aria-label={isGerman ? 'Switch to English' : 'Zu Deutsch wechseln'}
        >
          <span class={isGerman ? 'text-[var(--color-accent-primary)]' : 'text-[var(--color-text-muted)]'}>DE</span>
          <span class="text-[var(--color-border)]">/</span>
          <span class={!isGerman ? 'text-[var(--color-accent-primary)]' : 'text-[var(--color-text-muted)]'}>EN</span>
        </a>

        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] transition-colors"
          aria-label="Toggle theme"
        >
          <Icon name="lucide:sun" class="w-5 h-5 hidden dark:block" />
          <Icon name="lucide:moon" class="w-5 h-5 block dark:hidden" />
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]"
        aria-label="Open menu"
      >
        <Icon name="lucide:menu" class="w-6 h-6" id="menu-open-icon" />
        <Icon name="lucide:x" class="w-6 h-6 hidden" id="menu-close-icon" />
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[var(--color-border)] bg-[var(--color-bg-primary)]">
    <div class="px-6 py-8 space-y-6">
      <!-- Section Label -->
      <div class="flex items-center gap-3">
        <div class="w-8 h-[1px] bg-[var(--color-accent-primary)]"></div>
        <span class="font-display text-xs tracking-[0.2em] text-[var(--color-text-muted)] uppercase">Navigation</span>
      </div>

      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block font-display text-2xl font-semibold text-[var(--color-text-primary)] hover:text-[var(--color-accent-primary)] transition-colors"
        >
          {link.label}
        </a>
      ))}

      <!-- Services Section -->
      <div class="pt-4 border-t border-[var(--color-border-subtle)]">
        <span class="font-display text-xs tracking-[0.2em] text-[var(--color-text-muted)] uppercase block mb-4">Services</span>
        <div class="space-y-3">
          {serviceLinks.map((service) => (
            <a
              href={service.href}
              class="block text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] transition-colors"
            >
              {service.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Bottom Actions -->
      <div class="pt-6 border-t border-[var(--color-border)] flex items-center justify-between">
        <a
          href={alternatePath}
          class="flex items-center gap-2 font-display text-sm tracking-wider"
        >
          <span class={isGerman ? 'text-[var(--color-accent-primary)]' : 'text-[var(--color-text-muted)]'}>DE</span>
          <span class="text-[var(--color-border)]">/</span>
          <span class={!isGerman ? 'text-[var(--color-accent-primary)]' : 'text-[var(--color-text-muted)]'}>EN</span>
        </a>

        <button
          id="mobile-theme-toggle"
          class="p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] transition-colors"
          aria-label="Toggle theme"
        >
          <Icon name="lucide:sun" class="w-5 h-5 hidden dark:block" />
          <Icon name="lucide:moon" class="w-5 h-5 block dark:hidden" />
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Services Popover Overlay -->
<div
  id="services-popover-overlay"
  class="fixed inset-0 z-40 bg-[var(--color-bg-primary)]/60 backdrop-blur-md opacity-0 invisible transition-all duration-500"
  aria-hidden="true"
></div>

<!-- Services Popover -->
<div
  id="services-popover"
  class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-50 opacity-0 invisible transition-all duration-500 scale-95"
  role="dialog"
  aria-modal="true"
  aria-labelledby="services-popover-title"
>
  <!-- Clean Container -->
  <div class="relative bg-[var(--color-bg-secondary)] min-w-[520px] max-w-[600px] shadow-2xl">
    
    <!-- Diagonal Background Pattern -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 35px, var(--color-accent-primary) 35px, var(--color-accent-primary) 36px);"></div>
    
    <!-- Content Container -->
    <div class="relative p-10 border border-[var(--color-border)]">
      
      <!-- Header with System Status -->
      <div class="flex items-start justify-between mb-8">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <div class="w-2 h-2 rounded-full bg-[var(--color-accent-primary)] animate-pulse"></div>
            <span class="font-display text-[10px] tracking-[0.3em] text-[var(--color-accent-primary)] uppercase">System.Active</span>
          </div>
          <h2 id="services-popover-title" class="font-display text-3xl font-bold text-[var(--color-text-primary)] tracking-tight">
            {isGerman ? 'Leistungen' : 'Services'}
          </h2>
          <p class="font-body text-sm text-[var(--color-text-secondary)] mt-1 italic">
            {isGerman ? 'Wählen Sie ein Fachgebiet' : 'Select a specialty area'}
          </p>
        </div>
        
        <!-- Close Button - Technical Style -->
        <button
          id="services-popover-close"
          class="group relative w-10 h-10 border border-[var(--color-border)] hover:border-[var(--color-accent-primary)] transition-colors"
          aria-label="Close"
        >
          <span class="absolute inset-0 flex items-center justify-center">
            <Icon name="lucide:x" class="w-4 h-4 text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-primary)] transition-colors" />
          </span>
          <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 text-[8px] font-display tracking-wider text-[var(--color-text-muted)] opacity-0 group-hover:opacity-100 transition-opacity">ESC</span>
        </button>
      </div>

      <!-- Service Links - Horizontal Cards with Numbers -->
      <div class="space-y-0">
        {serviceLinks.map((service, index) => (
          <a
            href={service.href}
            class="service-link-item group relative flex items-stretch border-b border-[var(--color-border)] hover:border-[var(--color-accent-primary)] transition-all duration-300"
            style={`--delay: ${index * 80}ms`}
          >
            <!-- Number Column -->
            <div class="w-16 flex items-center justify-center border-r border-[var(--color-border)] group-hover:border-[var(--color-accent-primary)] group-hover:bg-[var(--color-accent-muted)] transition-all duration-300">
              <span class="font-display text-2xl font-bold text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-primary)] transition-colors">
                0{index + 1}
              </span>
            </div>
            
            <!-- Content Column -->
            <div class="flex-1 flex items-center justify-between px-6 py-5 group-hover:bg-[var(--color-bg-elevated)] transition-colors duration-300">
              <div>
                <span class="font-display text-base font-semibold text-[var(--color-text-primary)] block tracking-wide">
                  {service.label}
                </span>
                <span class="font-body text-xs text-[var(--color-text-muted)] italic opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-1 group-hover:translate-y-0">
                  {index === 0 ? (isGerman ? 'KI-Lösungen & Automation' : 'AI Solutions & Automation') :
                   index === 1 ? (isGerman ? 'Moderne Webtechnologien' : 'Modern Web Technologies') :
                   index === 2 ? (isGerman ? 'Cloud-Infrastruktur' : 'Cloud Infrastructure') :
                   (isGerman ? 'Sicherheitskonzepte' : 'Security Concepts')}
                </span>
              </div>
              
              <!-- Arrow Indicator -->
              <div class="w-10 h-10 border border-[var(--color-border)] group-hover:border-[var(--color-accent-primary)] flex items-center justify-center overflow-hidden">
                <Icon name="lucide:arrow-right" class="w-4 h-4 text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-primary)] transform -translate-x-8 group-hover:translate-x-0 transition-transform duration-300" />
                <Icon name="lucide:arrow-right" class="w-4 h-4 text-[var(--color-accent-primary)] absolute transform translate-x-0 group-hover:translate-x-8 transition-transform duration-300" />
              </div>
            </div>
            
            <!-- Hover Accent Line -->
            <div class="absolute bottom-0 left-0 w-0 h-[2px] bg-[var(--color-accent-primary)] group-hover:w-full transition-all duration-500"></div>
          </a>
        ))}
      </div>

      <!-- Footer - System Status Bar -->
      <div class="mt-8 pt-6 border-t border-[var(--color-border)] flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent-secondary)]"></div>
            <span class="font-display text-[10px] tracking-[0.2em] text-[var(--color-text-muted)] uppercase">4 Modules</span>
          </div>
          <div class="w-px h-4 bg-[var(--color-border)]"></div>
          <div class="flex items-center gap-2">
            <Icon name="lucide:check-circle" class="w-3 h-3 text-[var(--color-accent-primary)]" />
            <span class="font-display text-[10px] tracking-[0.2em] text-[var(--color-text-muted)] uppercase">Active</span>
          </div>
        </div>
        
        <a
          href={servicesUrl}
          id="services-overview-link"
          class="group flex items-center gap-3 font-display text-xs tracking-wider text-[var(--color-text-secondary)] hover:text-[var(--color-accent-primary)] transition-colors"
        >
          <span>{isGerman ? 'ÜBERSICHT' : 'OVERVIEW'}</span>
          <span class="w-8 h-[1px] bg-[var(--color-border)] group-hover:bg-[var(--color-accent-primary)] group-hover:w-12 transition-all"></span>
          <Icon name="lucide:arrow-right" class="w-3 h-3" />
        </a>
      </div>
    </div>
    
  </div>
</div>

<style>
  /* Popover Animation States */
  #services-popover.visible .service-link-item {
    animation: slideInRight 0.5s ease-out forwards;
    animation-delay: calc(var(--delay) + 0.3s);
    opacity: 0;
    transform: translateX(-20px);
  }
  
  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<script>
  // Theme toggle functionality
  function toggleTheme() {
    const html = document.documentElement;
    const currentTheme = html.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('mobile-theme-toggle')?.addEventListener('click', toggleTheme);

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  menuBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');

    if (isHidden) {
      mobileMenu?.classList.remove('hidden');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      mobileMenu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  });

  // Close menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  // Services Popover functionality
  const servicesTrigger = document.getElementById('services-popover-trigger');
  const servicesPopover = document.getElementById('services-popover');
  const servicesOverlay = document.getElementById('services-popover-overlay');
  const servicesClose = document.getElementById('services-popover-close');
  const servicesChevron = document.getElementById('services-chevron');
  const servicesOverviewLink = document.getElementById('services-overview-link');

  function openServicesPopover() {
    servicesPopover?.classList.remove('opacity-0', 'invisible', 'scale-95');
    servicesPopover?.classList.add('opacity-100', 'visible', 'scale-100');
    servicesOverlay?.classList.remove('opacity-0', 'invisible');
    servicesOverlay?.classList.add('opacity-100', 'visible');
    servicesChevron?.classList.add('rotate-180');
    servicesTrigger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeServicesPopover() {
    servicesPopover?.classList.add('opacity-0', 'invisible', 'scale-95');
    servicesPopover?.classList.remove('opacity-100', 'visible', 'scale-100');
    servicesOverlay?.classList.add('opacity-0', 'invisible');
    servicesOverlay?.classList.remove('opacity-100', 'visible');
    servicesChevron?.classList.remove('rotate-180');
    servicesTrigger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  servicesTrigger?.addEventListener('click', () => {
    const isExpanded = servicesTrigger.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeServicesPopover();
    } else {
      openServicesPopover();
    }
  });

  servicesClose?.addEventListener('click', closeServicesPopover);
  servicesOverlay?.addEventListener('click', closeServicesPopover);

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && servicesTrigger?.getAttribute('aria-expanded') === 'true') {
      closeServicesPopover();
    }
  });

  // Close popover when clicking service links (navigate to new page)
  servicesPopover?.querySelectorAll('a').forEach(link => {
    if (link.id !== 'services-overview-link') {
      link.addEventListener('click', closeServicesPopover);
    }
  });
</script>
