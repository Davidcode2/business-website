---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = getTranslations(locale);

const valueProps = [
  {
    icon: "lucide:message-circle",
    title: t.story.valueProps.noMeetings.title,
    description: t.story.valueProps.noMeetings.description,
  },
  {
    icon: "lucide:user",
    title: t.story.valueProps.noBloatedTeams.title,
    description: t.story.valueProps.noBloatedTeams.description,
  },
  {
    icon: "lucide:crosshair",
    title: t.story.valueProps.justResults.title,
    description: t.story.valueProps.justResults.description,
  },
];

const stats = [
  { value: '5+', label: t.story.stats.experience },
  { value: '20+', label: t.story.stats.projects },
  { value: '100%', label: t.story.stats.satisfaction },
  { value: '24/7', label: t.story.stats.support },
];
---

<section id="about" class="relative py-32 overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Large section number -->
    <div class="absolute -right-8 top-32 text-[20rem] font-display font-bold text-[var(--color-text-primary)] opacity-[0.015] leading-none select-none">
      03
    </div>
    <!-- Decorative line -->
    <div class="absolute left-0 top-1/2 w-1/4 h-[1px] bg-gradient-to-r from-transparent to-[var(--color-border)]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-16">
      <!-- Left Content -->
      <div class="lg:col-span-7 space-y-12">
        <!-- Section Marker -->
        <div class="flex items-center gap-4">
          <div class="w-12 h-[1px] bg-[var(--color-accent-primary)]"></div>
          <span class="font-display text-xs tracking-[0.3em] text-[var(--color-accent-primary)] uppercase">
            {t.story.sectionTagline}
          </span>
        </div>

        <!-- Headline -->
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-[var(--color-text-primary)] leading-[1]">
          <span class="block">{t.story.sectionTitle1}</span>
          <span class="block gradient-text">{t.story.sectionTitle2}</span>
        </h2>

        <!-- Description -->
        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-2xl font-body">
          {t.story.description}
        </p>

        <!-- Value Props -->
        <div class="space-y-8 pt-4">
          {valueProps.map((prop, index) => (
            <div class="flex gap-6 group">
              <!-- Icon -->
              <div class="flex-shrink-0 w-12 h-12 border border-[var(--color-border)] flex items-center justify-center group-hover:border-[var(--color-accent-primary)] transition-colors">
                <Icon name={prop.icon} class="w-5 h-5 text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-primary)] transition-colors" />
              </div>
              <!-- Content -->
              <div>
                <h3 class="font-display text-lg font-semibold text-[var(--color-text-primary)] mb-1">
                  {prop.title}
                </h3>
                <p class="text-[var(--color-text-secondary)] font-body">
                  {prop.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Content: Stats -->
      <div class="lg:col-span-5">
        <div class="relative">
          <!-- Stats Grid -->
          <div class="grid grid-cols-2 gap-px bg-[var(--color-border)]">
            {stats.map((stat, index) => (
              <div class="stat-card bg-[var(--color-bg-secondary)]">
                <div class="font-display text-4xl sm:text-5xl font-bold text-[var(--color-accent-primary)] mb-2">
                  {stat.value}
                </div>
                <div class="text-sm text-[var(--color-text-secondary)] font-body leading-tight">
                  {stat.label}
                </div>
                <!-- Corner marker -->
                <div class="absolute top-2 right-2 w-2 h-2 border-t border-r border-[var(--color-text-muted)] opacity-30"></div>
              </div>
            ))}
          </div>

          <!-- Decorative frame -->
          <div class="absolute -inset-4 border border-[var(--color-border)] -z-10"></div>
          <div class="absolute -top-2 -right-2 w-8 h-8 border-t-2 border-r-2 border-[var(--color-accent-secondary)]"></div>
          <div class="absolute -bottom-2 -left-2 w-8 h-8 border-b-2 border-l-2 border-[var(--color-accent-secondary)]"></div>
        </div>

        <!-- Technical note -->
        <div class="mt-8 p-6 border-l-2 border-[var(--color-accent-primary)] bg-[var(--color-accent-muted)]">
          <div class="flex items-start gap-4">
            <Icon name="lucide:info" class="w-5 h-5 text-[var(--color-accent-primary)] flex-shrink-0 mt-0.5" />
            <div>
              <span class="font-display text-xs tracking-wider text-[var(--color-accent-primary)] uppercase block mb-1">
                {locale === 'de' ? 'Arbeitsweise' : 'Working Method'}
              </span>
              <p class="text-sm text-[var(--color-text-secondary)] font-body">
                {locale === 'de'
                  ? 'Agile Entwicklung mit transparenten Meilensteinen. Regelmäßige Updates und direkte Kommunikation ohne Umwege.'
                  : 'Agile development with transparent milestones. Regular updates and direct communication without detours.'}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
