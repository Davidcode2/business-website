---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = getTranslations(locale);
const isGerman = locale === 'de';

const valueProps = [
  {
    icon: "lucide:message-circle",
    title: t.story.valueProps.noMeetings.title,
    description: t.story.valueProps.noMeetings.description,
  },
  {
    icon: "lucide:user",
    title: t.story.valueProps.noBloatedTeams.title,
    description: t.story.valueProps.noBloatedTeams.description,
  },
  {
    icon: "lucide:crosshair",
    title: t.story.valueProps.justResults.title,
    description: t.story.valueProps.justResults.description,
  },
];
---

<section id="about" class="relative py-24 lg:py-32 bg-[var(--color-bg-secondary)] border-y border-[var(--color-border)]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16">

      <!-- Label column -->
      <div class="lg:col-span-3">
        <div class="section-marker">
          <span>{t.story.sectionTagline}</span>
        </div>
      </div>

      <!-- Content -->
      <div class="lg:col-span-9 space-y-12">
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-[var(--color-text-primary)] leading-[1.05] tracking-tight max-w-3xl">
          {t.story.sectionTitle1}
          <span class="text-[var(--color-accent-primary)]">{t.story.sectionTitle2}</span>
        </h2>

        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-2xl">
          {t.story.description}
        </p>

        <!-- Value props: numbered datasheet cells, equalized via flex -->
        <div class="grid sm:grid-cols-3 gap-px bg-[var(--color-border)] border border-[var(--color-border)]">
          {valueProps.map((prop, index) => (
            <div class="relative bg-[var(--color-bg-primary)] p-6 lg:p-8 group hover:bg-[var(--color-bg-elevated)] transition-colors flex flex-col">
              <div class="absolute top-0 left-0 right-0 h-[3px] bg-[var(--color-accent-primary)] opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <span class="font-mono text-base font-semibold text-[var(--color-accent-primary)] block mb-3">
                0{index + 1}
              </span>
              <h3 class="font-display text-lg font-bold text-[var(--color-text-primary)] mb-2 leading-snug">
                {prop.title}
              </h3>
              <p class="text-[15px] text-[var(--color-text-secondary)] leading-relaxed">
                {prop.description}
              </p>
            </div>
          ))}
        </div>

        <!-- Honest facts strip — anchored to the cards, 2×2 on small, 4-up on large -->
        <div class="border border-[var(--color-border)] border-t-0 bg-[var(--color-bg-primary)] px-6 lg:px-8 py-4 grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-3">
          {[
            isGerman ? '5+ Jahre Berufserfahrung' : '5+ years experience',
            isGerman ? '20+ Projekte ausgeliefert' : '20+ projects shipped',
            isGerman ? '1 Ansprechpartner — ich' : '1 point of contact — me',
            'Hosting 100% DE',
          ].map((fact) => (
            <div class="flex items-center gap-2.5">
              <div class="w-1.5 h-1.5 bg-[var(--color-accent-primary)] flex-shrink-0"></div>
              <span class="font-mono text-xs sm:text-sm text-[var(--color-text-primary)]">{fact}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
