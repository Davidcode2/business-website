---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	lang?: string;
}

const { title, description = "Jakob Lingel - Digital Solutions Provider", lang = "de" } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#faf8f5" />
		<title>{title}</title>

		<!-- Open Graph / Social -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://jakob-lingel.dev" />

		<!-- Preconnect to Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <script defer src="https://analytics.jakob-lingel.dev/script.js" data-website-id="9d42db37-7496-443c-ada0-ed5b57d16b64"></script>
	</head>
	<body class="antialiased min-h-screen bg-[var(--color-bg-primary)] text-[var(--color-text-primary)]">
		<slot />
	</body>
</html>

<script is:inline>
	// Theme: light-first, persisted preference wins
	const theme = (() => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
			return localStorage.getItem('theme');
		}
		return 'light';
	})();

	document.documentElement.setAttribute('data-theme', theme);
</script>
